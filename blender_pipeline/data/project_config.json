{
  "project_name": "钢筋混凝土框架拆除动画",
  "description": "标准框架拆除动画 — stories×bays_x×bays_y 参数化生成",
  "fps": 24,
  "render_enabled": false,
  "render_comment": "默认false不渲染，加--render启用",
  "resolution_x": 960,
  "resolution_y": 540,
  "building": {
    "stories": 3,
    "bays_x": 3,
    "bays_y": 3,
    "bay_width_x": 6.0,
    "bay_width_y": 6.0,
    "story_height": 3.3,
    "column_size": 0.5,
    "beam_width": 0.3,
    "beam_height": 0.6,
    "slab_thickness": 0.15
  },
  "demolition_strategy": {
    "order": "top_down",
    "demolition_mode": "by_floor_type",
    "within_floor_sort": "importance_desc",
    "importance_map": {
      "slab": 3,
      "beam_x": 2,
      "beam_y": 2,
      "column": 1,
      "foundation": 0
    },
    "frame_per_step": 24,
    "transition_frames": 8,
    "overlap_frames": 4
  },
  "machinery": {
    "enabled": false
  }
}
